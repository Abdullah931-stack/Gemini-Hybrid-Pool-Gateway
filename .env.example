# ==============================================================================
# Gemini-Hybrid-Pool-Gateway Environment Configuration
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials (Optional for OAuth CLI Channels)
# Default public Antigravity CLI client credentials are built into the gateway,
# making these optional out-of-the-box.
# You can optionally specify custom credentials created as a Desktop Application
# in Google Cloud Console: https://console.cloud.google.com/apis/credentials
# To strictly disable the built-in fallback credentials and require custom ones,
# set GHPG_DISABLE_BUILTIN_OAUTH_CLIENT=1.
# ------------------------------------------------------------------------------
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
# GHPG_DISABLE_BUILTIN_OAUTH_CLIENT=0

# ------------------------------------------------------------------------------
# System Storage Paths & LMDB Configuration
# ------------------------------------------------------------------------------
ACCOUNTS_FILE_PATH=config/accounts.json
COOKIES_CACHE_DIR=config/cookies_cache
LMDB_DIR=config/lmdb_data
LMDB_MAP_SIZE=104857600
