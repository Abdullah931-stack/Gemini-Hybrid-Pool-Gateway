# ==============================================================================
# Gemini-Hybrid-Pool-Gateway Environment Configuration
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials (Required for OAuth CLI Channels)
# Create a Desktop Application OAuth client in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# ------------------------------------------------------------------------------
GEMINI_OAUTH_CLIENT_ID=YOUR_CLIENT_ID_HERE.apps.googleusercontent.com
GEMINI_OAUTH_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE

# ------------------------------------------------------------------------------
# System Storage Paths & LMDB Configuration
# ------------------------------------------------------------------------------
ACCOUNTS_FILE_PATH=config/accounts.json
COOKIES_CACHE_DIR=config/cookies_cache
LMDB_DIR=config/lmdb_data
LMDB_MAP_SIZE=104857600
